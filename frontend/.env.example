VITE_APP_NAME=FinSightAI
# Public API origin, without /api. Must use HTTPS when the frontend uses HTTPS.
VITE_API_URL=http://localhost:8000
# Optional: must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=
# Idle timeout in seconds. A session ends after 30 minutes without interaction.
VITE_SESSION_TIMEOUT=1800
VITE_RATE_LIMIT_ATTEMPTS=5
VITE_RATE_LIMIT_DURATION=30
