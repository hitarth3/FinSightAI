APP_NAME=FinSightAI
# Development only. Production defaults to False and requires a unique signing key.
DEBUG=True
DATABASE_URL=postgresql+asyncpg://finsight:local-password@localhost:5432/finsight
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-generated-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# No delivery provider exists yet. Leave disabled.
ENABLE_MFA=False
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_DURATION=30
# Optional integrations. Core tracking works without them.
GOOGLE_CLIENT_ID=
AI_PROVIDER=groq
GROQ_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
N8N_ANALYTIC_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
